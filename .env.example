XAI_API_KEY=enter-your-api-here
TAXGROK_MODEL=grok-4-fast
TAXGROK_TIMEOUT_SECONDS=90
# Set to 1 to keep remote files for debugging (default auto-cleanup)
# TAXGROK_KEEP_REMOTE_FILES=1
# Set to 1 to run IRS URL refresh checks before generation
# TAXGROK_REFRESH_IRS_SOURCES=1
# Local redaction is ON by default; set to 0 to disable
# TAXGROK_LOCAL_REDACTION=0
# Set to 1 to force plain menu mode (no ASCII intro/dashboard)
# TAXGROK_NO_STYLE=1
